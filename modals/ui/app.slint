import { LineEdit } from "std-widgets.slint";

// Embed the app's fonts (families: "Outfit", "Montserrat") and the subset icon
// font (family: "MaterialSymbols") at compile time.
import "../assets/Outfit.ttf";
import "../assets/Montserrat.ttf";
import "../assets/MaterialSymbolsSubset.ttf";

// A small curated subset of the app's design tokens (see common-ui/styles/tokens.css),
// converted from oklch to sRGB. Not the full palette — enough to feel native to
// Taskscape. `dark` is set once at launch from the resolved theme.
export global Palette {
    in property <bool> dark: false;

    out property <brush> surface-0: dark ? #0f1012 : #ebecee;
    out property <brush> surface-1: dark ? #161719 : #f3f4f6;
    out property <brush> surface-2: dark ? #1e1f22 : #fdfdfe;
    out property <brush> surface-3: dark ? #292b2e : #ffffff;

    out property <brush> content-1: dark ? #e9ebee : #21242a;
    out property <brush> content-2: dark ? #a8abb0 : #545860;
    out property <brush> content-3: dark ? #74787e : #82868e;

    out property <brush> edge-2: dark ? #f5f9ff1c : #2d333d24;
    out property <brush> edge-3: dark ? #f5f9ff3d : #2d333d4c;

    out property <brush> accent: dark ? #3a9bfd : #007df3;
    out property <brush> accent-hover: dark ? #53abff : #006ce7;
    out property <brush> on-accent: #fafcff;
    out property <brush> selection: dark ? #3a9bfd29 : #007df31a;

    out property <brush> danger: dark ? #f75d59 : #cc2827;
    out property <brush> danger-hover: dark ? #ff6f69 : #bb0916;
    out property <brush> danger-soft: dark ? #f75d5926 : #cc28271a;

    out property <brush> wash: dark ? #f5f9ff14 : #2d333d17;
}

// Material Symbols glyphs used directly in the chrome (the per-modal icon comes
// from Rust as `icon-glyph`). Rendered with the embedded `MaterialSymbols` font.
export global Glyphs {
    out property <string> font: "MaterialSymbols";
    out property <string> close: "\u{e14c}";
    out property <string> check: "\u{e5ca}";
    out property <string> casino: "\u{eb40}";
    out property <string> tune: "\u{e429}";
}

struct ButtonData {
    id: string,
    label: string,
    variant: string,
}

struct SegOption {
    id: string,
    label: string,
}

// A footer action button (ghost / primary / danger), matched loosely to the app.
component PillButton inherits Rectangle {
    in property <string> label;
    in property <string> variant: "ghost";
    callback clicked;

    height: 32px;
    border-radius: 8px;
    border-width: variant == "ghost" ? 1px : 0px;
    border-color: Palette.edge-2;
    background: variant == "primary"
        ? (ta.has-hover ? Palette.accent-hover : Palette.accent)
        : variant == "danger"
            ? (ta.has-hover ? Palette.danger-hover : Palette.danger)
            : (ta.has-hover ? Palette.wash : Palette.surface-3);

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 12.5px;
            font-weight: 600;
            color: variant == "ghost" ? Palette.content-1 : Palette.on-accent;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A small round title-bar close affordance.
component CloseButton inherits Rectangle {
    callback clicked;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: ta.has-hover ? Palette.wash : transparent;
    Text {
        text: Glyphs.close;
        font-family: Glyphs.font;
        font-size: 15px;
        color: Palette.content-3;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// An equal-width segmented control.
component Segmented inherits Rectangle {
    in property <[SegOption]> options;
    in-out property <string> selected;
    callback changed;
    height: 28px;

    HorizontalLayout {
        spacing: 4px;
        for o in root.options: Rectangle {
            horizontal-stretch: 1;
            border-radius: 6px;
            background: o.id == root.selected ? Palette.accent : Palette.surface-0;
            Text {
                text: o.label;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-size: 12.5px;
                font-weight: 500;
                color: o.id == root.selected ? Palette.on-accent : Palette.content-2;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = o.id;
                    root.changed();
                }
            }
        }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> label;
    in-out property <bool> on;
    callback changed;
    height: 32px;
    border-radius: 6px;
    background: ta.has-hover ? Palette.wash : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            border-width: root.on ? 0px : 1.5px;
            border-color: Palette.edge-3;
            background: root.on ? Palette.accent : transparent;
            Text {
                text: root.on ? Glyphs.check : "";
                font-family: Glyphs.font;
                font-size: 12px;
                color: Palette.on-accent;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 13px;
            font-weight: 500;
            color: Palette.content-1;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.changed();
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Modal: renders any confirm/prompt from ModalProps.
// ─────────────────────────────────────────────────────────────────────────────
export component ModalView inherits Window {
    in property <string> heading;
    in property <string> message;
    in property <bool> has-message: false;
    in property <bool> has-icon: false;
    in property <string> icon-glyph;
    in property <string> icon-tone: "default";
    in property <bool> has-input: false;
    in property <string> input-placeholder;
    in-out property <string> input-value;
    in property <string> input-suffix;
    in property <bool> has-suffix: false;
    in property <bool> has-suggest: false;
    in property <[ButtonData]> buttons;

    callback button-clicked(string, bool);
    callback activate-default();
    callback dismiss();
    callback roll();

    title: "";
    no-frame: true;
    width: 400px;
    default-font-family: "Montserrat";
    background: Palette.surface-2;
    forward-focus: fs;

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            // Title bar
            Rectangle {
                height: 44px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: root.heading;
                        font-family: "Outfit";
                        vertical-alignment: center;
                        font-size: 14px;
                        font-weight: 600;
                        color: Palette.content-1;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        CloseButton {
                            clicked => {
                                root.dismiss();
                            }
                        }
                    }
                }
            }

            // Body
            if root.has-message || root.has-input: Rectangle {
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 2px;
                    padding-bottom: 18px;
                    spacing: 14px;

                    if root.has-icon: Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 8px;
                        background: root.icon-tone == "danger" ? Palette.danger-soft : Palette.selection;
                        Text {
                            text: root.icon-glyph;
                            font-family: Glyphs.font;
                            font-size: 20px;
                            color: root.icon-tone == "danger" ? Palette.danger : Palette.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 14px;

                        if root.has-message: Text {
                            text: root.message;
                            wrap: word-wrap;
                            font-size: 13px;
                            color: Palette.content-2;
                        }

                        if root.has-input: HorizontalLayout {
                            spacing: 6px;
                            input := LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: root.input-placeholder;
                                text <=> root.input-value;
                                init => {
                                    self.focus();
                                }
                                accepted => {
                                    root.activate-default();
                                }
                            }
                            if root.has-suffix: Text {
                                text: root.input-suffix;
                                vertical-alignment: center;
                                font-size: 13px;
                                color: Palette.content-3;
                            }
                            if root.has-suggest: dice := Rectangle {
                                width: 34px;
                                border-radius: 6px;
                                background: dta.has-hover ? Palette.wash : Palette.surface-0;
                                Text {
                                    text: Glyphs.casino;
                                    font-family: Glyphs.font;
                                    font-size: 18px;
                                    color: Palette.content-2;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                dta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.roll();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Footer
            Rectangle {
                background: Palette.surface-1;
                height: 53px;
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    padding: 8px;
                    padding-right: 10px;
                    for b[i] in root.buttons: PillButton {
                        label: b.label;
                        variant: b.variant;
                        clicked => {
                            root.button-clicked(b.id, i == root.buttons.length - 1);
                        }
                    }
                }
            }
        }
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// Overlay: per-pane filter/sort. Streams each change back via `changed()`.
// ─────────────────────────────────────────────────────────────────────────────
export component OverlayView inherits Window {
    in property <string> pane-name;
    in-out property <string> sort: "manual";
    in-out property <string> dir: "asc";
    in-out property <string> filter: "all";
    in-out property <bool> has-notes: false;
    in-out property <bool> has-attachments: false;
    in-out property <bool> has-subtasks: false;
    in-out property <string> created: "any";

    callback changed;
    callback dismiss;

    property <bool> active: sort != "manual" || dir != "asc" || filter != "all"
        || has-notes || has-attachments || has-subtasks || created != "any";

    property <[SegOption]> sort-options: [
        { id: "manual", label: "Manual" },
        { id: "created", label: "Date created" },
        { id: "alpha", label: "Alphabetical" },
        { id: "done-last", label: "Done last" },
    ];
    property <[SegOption]> filter-options: [
        { id: "all", label: "All" },
        { id: "active", label: "Active" },
        { id: "completed", label: "Completed" },
    ];
    property <[SegOption]> created-options: [
        { id: "any", label: "Any time" },
        { id: "today", label: "Today" },
        { id: "week", label: "This week" },
        { id: "month", label: "This month" },
    ];

    title: "";
    no-frame: true;
    width: 340px;
    default-font-family: "Montserrat";
    background: Palette.surface-2;
    forward-focus: fs;

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Return) {
                root.dismiss();
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            // Title bar
            Rectangle {
                height: 44px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: Glyphs.tune;
                        font-family: Glyphs.font;
                        font-size: 16px;
                        color: Palette.content-2;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Filter & Sort · " + root.pane-name;
                        font-family: "Outfit";
                        vertical-alignment: center;
                        font-size: 13.5px;
                        font-weight: 600;
                        color: Palette.content-1;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    VerticalLayout {
                        alignment: center;
                        CloseButton {
                            clicked => {
                                root.dismiss();
                            }
                        }
                    }
                }
            }

            // Sections
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 16px;
                spacing: 16px;

                // Sort by
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "SORT BY";
                        font-size: 10.5px;
                        font-weight: 600;
                        letter-spacing: 0.8px;
                        color: Palette.content-3;
                    }
                    Segmented {
                        options: root.sort-options;
                        selected <=> root.sort;
                        changed => {
                            root.changed();
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        PillButton {
                            label: "Ascending";
                            variant: root.dir == "asc" ? "primary" : "ghost";
                            clicked => {
                                if (root.sort != "manual") {
                                    root.dir = "asc";
                                    root.changed();
                                }
                            }
                        }
                        PillButton {
                            label: "Descending";
                            variant: root.dir == "desc" ? "primary" : "ghost";
                            clicked => {
                                if (root.sort != "manual") {
                                    root.dir = "desc";
                                    root.changed();
                                }
                            }
                        }
                    }
                }

                // Show
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "SHOW";
                        font-size: 10.5px;
                        font-weight: 600;
                        letter-spacing: 0.8px;
                        color: Palette.content-3;
                    }
                    Segmented {
                        options: root.filter-options;
                        selected <=> root.filter;
                        changed => {
                            root.changed();
                        }
                    }
                }

                // Refine
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "REFINE";
                        font-size: 10.5px;
                        font-weight: 600;
                        letter-spacing: 0.8px;
                        color: Palette.content-3;
                    }
                    ToggleRow {
                        label: "Has notes";
                        on <=> root.has-notes;
                        changed => {
                            root.changed();
                        }
                    }
                    ToggleRow {
                        label: "Has attachments";
                        on <=> root.has-attachments;
                        changed => {
                            root.changed();
                        }
                    }
                    ToggleRow {
                        label: "Has subtasks";
                        on <=> root.has-subtasks;
                        changed => {
                            root.changed();
                        }
                    }
                }

                // Created
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "CREATED";
                        font-size: 10.5px;
                        font-weight: 600;
                        letter-spacing: 0.8px;
                        color: Palette.content-3;
                    }
                    Segmented {
                        options: root.created-options;
                        selected <=> root.created;
                        changed => {
                            root.changed();
                        }
                    }
                }
            }

            // Footer
            Rectangle {
                background: Palette.surface-1;
                height: 52px;
                HorizontalLayout {
                    padding: 10px;
                    spacing: 8px;
                    PillButton {
                        label: "Reset";
                        variant: "ghost";
                        clicked => {
                            root.sort = "manual";
                            root.dir = "asc";
                            root.filter = "all";
                            root.has-notes = false;
                            root.has-attachments = false;
                            root.has-subtasks = false;
                            root.created = "any";
                            root.changed();
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    PillButton {
                        label: "Done";
                        variant: "primary";
                        clicked => {
                            root.dismiss();
                        }
                    }
                }
            }
        }
    }
}
